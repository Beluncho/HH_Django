DEBUG=1
SECRET_KEY=replace-with-a-local-development-secret
ALLOWED_HOSTS=localhost 127.0.0.1 [::1]

POSTGRES_ENGINE=django.db.backends.postgresql
POSTGRES_DB=django_db
POSTGRES_USER=django_user
POSTGRES_PASSWORD=django_password
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE=postgres

HH_API_DOMAIN=https://api.hh.ru/
HH_ACCESS_TOKEN=
HH_REQUIRE_ACCESS_TOKEN=1
HH_USER_AGENT=HH_Django/1.0 ()
HH_REQUEST_TIMEOUT=10
HH_ANALYSIS_LIMIT=20

EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
EMBEDDING_CACHE_DIR=/app/.model-cache

# LLM is required for skill explanations and interviews.
# "disabled" keeps vacancy analysis available but disables LLM generation.
# Any other provider name uses the OpenAI Chat Completions API.
# Direct OpenAI: leave LLM_BASE_URL empty.
# ProxyAPI: set LLM_BASE_URL=https://openai.api.proxyapi.ru/v1.
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=sk-
LLM_BASE_URL=
# Legacy alias. Prefer LLM_BASE_URL; this may contain the previous full
# .../chat/completions endpoint.
LLM_API_URL=
LLM_TIMEOUT=30
LLM_MAX_TOKENS=1200

# This switch affects newly created interview sessions.
# 1 = use the global "interview" collection when it contains documents.
# 0 = conduct interviews without interview RAG.
# Enabling the flag does not create the collection: import documents with
# "python manage.py import_knowledge ... --collection interview".
INTERVIEW_RAG_ENABLED=1
KNOWLEDGE_IMPORT_MAX_BYTES=2097152
