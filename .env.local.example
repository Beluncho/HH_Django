# Локальное окружение для запуска без Docker.
#
# Установка зависимостей и venv — см. «Подготовка окружения» в
# HH/candidate_trainer/docs/command_run_analysis_demo.md
#
# Скопируйте файл в .env.local и заполните значения:
#   cp .env.local.example .env.local
#
# ВАЖНО:
#  - не задавайте POSTGRES_* — иначе вместо локального SQLite будет
#    использоваться PostgreSQL по адресу из этих переменных;
#  - не задавайте EMBEDDING_CACHE_DIR: в .env.dev там контейнерный путь
#    /app/.model-cache, а git-bash на Windows переписывает его в
#    C:/Program Files/Git/app/.model-cache. Без этой переменной применится
#    локальный HH/.model-cache;
#  - значения с пробелами и скобками пишите в кавычках: файл загружается
#    шеллом через `set -a; . ./.env.local`, и без кавычек строка с пробелом
#    ломает sourcing (обычно это HH_USER_AGENT и ALLOWED_HOSTS);
#  - .env.local в git не попадает, секреты в репозиторий не уходят.

DEBUG=1
SECRET_KEY=replace-with-a-local-development-secret
ALLOWED_HOSTS="localhost 127.0.0.1 [::1]"

HH_API_DOMAIN=https://api.hh.ru/
HH_ACCESS_TOKEN=replace-with-your-hh-api-token
HH_REQUIRE_ACCESS_TOKEN=1
HH_USER_AGENT="HH_Django/1.0 (your-real-email@example.com)"
HH_REQUEST_TIMEOUT=10
HH_ANALYSIS_LIMIT=20

# Значения совпадают с .env.dev и .env.prod: локальный прогон и Docker работают
# с одной и той же моделью, векторы одинаковые. Требуется torch и
# sentence-transformers (установка — в HH/candidate_trainer/docs/command_run_analysis_demo.md).
# При первом запуске модель скачается, ~470 МБ.
#
# Облегчённая альтернатива без torch — hash. Менять нужно ОБЕ строки сразу, иначе
# загрузка упадёт: local-hash-v1 не является моделью Hugging Face.
#   EMBEDDING_PROVIDER=hash
#   EMBEDDING_MODEL=local-hash-v1
# После смены провайдера или модели обязательна переиндексация:
#   ./run_local.sh reindex_embeddings
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DIMENSION=384
EMBEDDING_DEVICE=cpu
# EMBEDDING_CACHE_DIR не задаём: применится локальный HH/.model-cache (~470 МБ при
# первом запуске; каталог добавлен в .gitignore)

LLM_PROVIDER=OpenAI
LLM_MODEL=google/gemini-2.5-flash-lite
# ПОДСТАВЬТЕ: ключ вашего LLM-провайдера. Больше в файле менять нечего.
LLM_API_KEY=replace-with-your-llm-api-key
# Базовый адрес провайдера без /chat/completions: клиент использует официальный
# SDK openai и дописывает путь сам. Для прямого OpenAI оставьте пустым — SDK
# возьмёт свой адрес; LLM_API_URL остаётся алиасом и может содержать полный
# endpoint, /chat/completions из него отрезается.
LLM_BASE_URL=https://api.proxyapi.ru/v1
LLM_API_URL=
LLM_TIMEOUT=30
LLM_MAX_TOKENS=4000
# Имя параметра лимита в теле запроса: max_tokens (старые OpenAI-совместимые API)
# или max_completion_tokens (новые модели OpenAI — иначе ответ 400).
LLM_MAX_TOKENS_PARAM=max_tokens
# Пустая строка означает «не отправлять temperature»: часть моделей принимает
# только значение по умолчанию и отвечает 400 на любое явное.
LLM_TEMPERATURE=0.2

INTERVIEW_RAG_ENABLED=1
KNOWLEDGE_IMPORT_MAX_BYTES=2097152
